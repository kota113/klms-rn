{
  "expo": {
    "name": "K-app",
    "slug": "K-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "experiments": {
      "reactCompiler": true
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "LSSupportsOpeningDocumentsInPlace": true,
        "NSCameraUsageDescription": "課題提出時に撮影したファイルをアップロードするためにカメラを使用します。",
        "NSMicrophoneUsageDescription": "課題提出時に動画をアップロードするためにマイクを使用します。",
        "NSPhotoLibraryUsageDescription": "課題提出時に写真やファイルを選択してアップロードするために使用します。",
        "UIFileSharingEnabled": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#081f6f"
      },
      "package": "com.kota113.klms",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "ed14aa7f-419c-49c3-b03f-a8a85e29f53f"
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/adaptive-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#081f6f"
        }
      ],
      "expo-secure-store",
      "expo-web-browser"
    ]
  }
}
